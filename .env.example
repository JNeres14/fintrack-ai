# Copie para .env e preencha. Nunca commite o .env.
# Nomes das variáveis previstas; valores reais ficam só no .env local.

# PostgreSQL (docker-compose de desenvolvimento)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Backend: conexão com o banco (Fase 2)
DB_URL=
DB_USER=
DB_PASSWORD=

# Backend: segurança (Fase 2)
JWT_SECRET=
CORS_ALLOWED_ORIGINS=

# IA (Fase 4 em diante)
AI_PROVIDER_API_KEY=
