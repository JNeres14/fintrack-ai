# Copie para .env e preencha. Nunca commite o .env.
# Nomes das variáveis previstas; valores reais ficam só no .env local.

# PostgreSQL (docker-compose de desenvolvimento)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Backend: conexão com o banco (Fase 2), PostgreSQL 17 local
# DB_URL (desenvolvimento): jdbc:postgresql://localhost:5432/fintrack
# DB_TEST_URL (testes, SEMPRE o banco fintrack_test): jdbc:postgresql://localhost:5432/fintrack_test
# O mesmo usuário/senha vale para os dois bancos. Formato .properties: barra invertida (\) vira \\.
DB_URL=
DB_TEST_URL=
DB_USER=
DB_PASSWORD=

# Backend: segurança (Fase 2)
# JWT_SECRET: obrigatório, mínimo 32 bytes aleatórios (ex.: gerar com `openssl rand -base64 48`). Sem padrão.
# CORS_ALLOWED_ORIGINS: origens do frontend separadas por vírgula, sem curinga (ex.: a do Vite em dev). Vazio = nenhuma.
# As demais têm padrão seguro no application.properties; só descomente e preencha para mudar (vazio quebra a inicialização, por isso ficam comentadas):
#   JWT_ACCESS_TTL_MINUTES (padrão 15, máx. 15), JWT_REFRESH_TTL_DAYS (7), AUTH_MAX_FAILED_ATTEMPTS (5),
#   AUTH_LOCK_MINUTES (15), AUTH_RATE_LIMIT_PER_MINUTE (10)
JWT_SECRET=
CORS_ALLOWED_ORIGINS=
# JWT_ACCESS_TTL_MINUTES=
# JWT_REFRESH_TTL_DAYS=
# AUTH_MAX_FAILED_ATTEMPTS=
# AUTH_LOCK_MINUTES=
# AUTH_RATE_LIMIT_PER_MINUTE=

# IA (Fase 4 em diante)
AI_PROVIDER_API_KEY=

# Fuso da data de negócio / fechamento da fatura do cartão (padrão America/Sao_Paulo). Descomente só para mudar.
# APP_TIMEZONE=
